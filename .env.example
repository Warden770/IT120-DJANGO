# Copy this file to ".env" and fill in your own values.
# ".env" is listed in .gitignore - NEVER commit it or show it in the demo video.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- SMS provider ---
# "twilio"  -> really sends SMS through Twilio (needs the credentials below)
# "console" -> SIMULATION ONLY: nothing is sent, useful for UI development
SMS_BACKEND=twilio

# Twilio Console -> Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Sender: use EITHER a Twilio phone number OR a Messaging Service SID
TWILIO_PHONE_NUMBER=+10000000000
TWILIO_MESSAGING_SERVICE_SID=

# Country code (digits only) used to convert local numbers such as 0917... to +63917...
DEFAULT_COUNTRY_CODE=63
