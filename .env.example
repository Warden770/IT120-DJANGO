# Copy this file to ".env" and fill in your own values.
# ".env" is listed in .gitignore - NEVER commit it or show it in the demo video.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- SMS provider ---
# "textbee" -> really sends SMS through the TextBee gateway (needs the key below)
# "console" -> SIMULATION ONLY: nothing is sent, useful for UI development
SMS_BACKEND=textbee

# TextBee dashboard -> API Keys -> Generate API Key (shown only once!)
TEXTBEE_API_KEY=your_textbee_api_key_here

# Optional: the ID of the phone to send from (dashboard -> Devices).
# Leave empty to use your default registered phone.
TEXTBEE_DEVICE_ID=

# Country code (digits only) used to convert local numbers such as 0917... to +63917...
DEFAULT_COUNTRY_CODE=63
